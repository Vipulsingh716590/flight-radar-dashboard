# Used by docker-compose.yml (copy to .env, which is git-ignored).
# This is NOT the backend's own backend/.env used for plain local development.

# --- required for `--profile app` ---------------------------------------------
# Session signing secret, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The seed admin account (there is no registration). Password: 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- database ------------------------------------------------------------------
# Use URL-safe characters only (letters, digits, - and _), e.g. base64url output.
POSTGRES_PASSWORD=

# --- public address ------------------------------------------------------------
# Origin people type in the browser. Must match exactly (scheme + host + port).
PUBLIC_URL=http://localhost:8080
# Host port for the web container (bound to 127.0.0.1).
WEB_PORT=8080

# --- HTTPS with Caddy (`--profile tls`) ------------------------------------------
DOMAIN=
# Caddy + nginx are two proxies in front of the API.
# TRUST_PROXY_HOPS=2

# --- optional --------------------------------------------------------------------
# POLL_INTERVAL_SECONDS=75
# RETENTION_DAYS=7
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# Only for plain-HTTP testing over a LAN address (never on the internet):
# COOKIE_SECURE=false
