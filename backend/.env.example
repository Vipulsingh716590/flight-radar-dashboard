# Copy to .env and adjust. Never commit .env.

PORT=3000
# The only browser origin allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:4200

# Seconds between poll cycles (minimum 60; a full adsb.fi sweep takes ~25 s).
POLL_INTERVAL_SECONDS=75

# Providers in priority order. Available: adsbfi, opensky
PROVIDER_ORDER=adsbfi,opensky

# Plane positions up to this far beyond the land border still count as India.
INDIA_BUFFER_KM=50

# Optional: OpenSky OAuth2 client (https://opensky-network.org -> Account -> API client).
# Without it OpenSky is limited to 400 credits/day (~100 requests).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Authentication (Phase 3) ---------------------------------------------
# Secret used to sign session tokens. Required in production; min 32 chars.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Seed admin: the only account until the users table arrives in Phase 4.
ADMIN_EMAIL=admin@example.com
# Plain password (min 12 chars, hashed at start-up) ...
ADMIN_PASSWORD=
# ... or a bcrypt hash instead (then leave ADMIN_PASSWORD empty).
ADMIN_PASSWORD_HASH=
# Session length in hours.
SESSION_HOURS=8
# Failed logins allowed per client IP / per email within the window, then HTTP 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Cookie: use COOKIE_SAMESITE=none (needs HTTPS) only if frontend and API are on different sites.
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the API (Render/nginx = 1), for correct client IPs.
TRUST_PROXY_HOPS=0

# --- Database (Phase 4) ------------------------------------------------------
# PostgreSQL connection string (required). Matches docker-compose.yml.
# No Docker? Run "npm run db:dev" for a local embedded PostgreSQL on the same URL.
DATABASE_URL=postgres://flightradar:flightradar@localhost:5432/flightradar
# Per-cycle flight snapshots older than this many days are deleted (hourly stats are kept).
RETENTION_DAYS=7

